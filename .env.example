# Database
# Dev default targets a local SQLite file so the app runs with zero external
# services. For production, point this at PostgreSQL and switch the
# `provider` in prisma/schema.prisma to "postgresql" (no model changes needed).
DATABASE_URL="file:./dev.db"

# Session signing (auth cookies). Generate a real secret for production, e.g.
# `openssl rand -base64 32`.
SESSION_SECRET="dev-only-insecure-secret-change-me"

# Storage. "local" writes to ./storage on disk using the same logical bucket
# layout the S3 provider would use (original/processed/thumbnails/...).
# Switch to "s3" and fill in the S3_* vars to use real object storage.
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# AI / video providers. "mock" is the only implementation wired up today
# (see src/providers). Reconstruction also supports "replicate" (real
# monocular depth estimation via Replicate's hosted Depth Anything V2 —
# see src/providers/reconstruction/replicate-depth-engine.ts), which
# needs REPLICATE_API_TOKEN set to a real token from
# replicate.com/account/api-tokens (plus billing enabled on that account),
# and "local-depth" (the same Depth Anything V2 model family, run locally
# and free via onnxruntime-node — see
# src/providers/reconstruction/local-depth-engine.ts), which needs no
# credentials at all, just the model file already committed under
# models/depth-estimation/.
# AI also supports "nvidia" (real LLM-backed concierge intent parsing +
# space descriptions via NVIDIA's hosted NIM catalog, free tier available
# at build.nvidia.com -> API Keys — see
# src/providers/ai/nvidia-ai-provider.ts), which needs NVIDIA_API_KEY.
RECONSTRUCTION_PROVIDER="mock"
REPLICATE_API_TOKEN=""
AI_PROVIDER="mock"
NVIDIA_API_KEY=""
NVIDIA_MODEL="meta/llama-3.1-8b-instruct"
NVIDIA_VISION_MODEL="microsoft/phi-3.5-vision-instruct"
VIDEO_PROVIDER="mock"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
