# Database
# Dev default targets a local SQLite file so the app runs with zero external
# services. For production, point this at PostgreSQL and switch the
# `provider` in prisma/schema.prisma to "postgresql" (no model changes needed).
DATABASE_URL="file:./dev.db"

# Session signing (auth cookies). Generate a real secret for production, e.g.
# `openssl rand -base64 32`.
SESSION_SECRET="dev-only-insecure-secret-change-me"

# Storage. "local" writes to ./storage on disk using the same logical bucket
# layout the S3 provider would use (original/processed/thumbnails/...).
# Switch to "s3" and fill in the S3_* vars to use real object storage.
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# AI / video providers. "mock" is the only implementation wired up today
# (see src/providers). Reconstruction also supports "replicate" (real
# monocular depth estimation via Replicate's hosted Depth Anything V2 —
# see src/providers/reconstruction/replicate-depth-engine.ts), which
# needs REPLICATE_API_TOKEN set to a real token from
# replicate.com/account/api-tokens (plus billing enabled on that account),
# and "local-depth" (the same Depth Anything V2 model family, run locally
# and free via onnxruntime-node — see
# src/providers/reconstruction/local-depth-engine.ts), which needs no
# credentials at all, just the model file already committed under
# models/depth-estimation/.
# AI also supports "nvidia" (real LLM-backed concierge intent parsing +
# space descriptions via NVIDIA's hosted NIM catalog, free tier available
# at build.nvidia.com -> API Keys — see
# src/providers/ai/nvidia-ai-provider.ts), which needs NVIDIA_API_KEY.
RECONSTRUCTION_PROVIDER="mock"
REPLICATE_API_TOKEN=""
AI_PROVIDER="mock"
NVIDIA_API_KEY=""
# meta/llama-3.1-8b-instruct (an earlier default here) hit HTTP 410 Gone —
# deprecated 2026-08-26. Verify current model ids against your own
# account via `GET /v1/models` before relying on any specific name; NVIDIA's
# catalog changes over time and not every listed model is enabled for
# every account (several 404 "not found for account" despite being
# listed). meta/llama-3.2-11b-vision-instruct is confirmed working for
# both plain chat and image input as of this writing.
NVIDIA_MODEL="meta/llama-3.2-11b-vision-instruct"
NVIDIA_VISION_MODEL="meta/llama-3.2-11b-vision-instruct"
# Voice (free-tier roadmap step A3). Riva NIMs aren't behind the shared
# integrate.api.nvidia.com endpoint — each has its own invocation URL,
# found on that model's build.nvidia.com page under its "API" tab. Note
# the ASR/TTS language codes are NOT symmetric: this ASR deployment needs
# "en-GB" (en-US 404s), TTS needs "en-US" — verified live, not assumed.
VOICE_PROVIDER="mock"
NVIDIA_ASR_URL=""
NVIDIA_TTS_URL=""
NVIDIA_TTS_VOICE="Magpie-Multilingual.EN-US.Aria.Neutral"
VIDEO_PROVIDER="mock"

# Real camera-pose estimation (COLMAP, run free on a GitHub Actions
# runner — free-tier plan step B1, docs/free-tier-roadmap.md, triggered
# from a space's "Estimate real camera pose" button). Needs:
# - GITHUB_DISPATCH_TOKEN: a GitHub PAT (fine-grained, `actions: write` on
#   this repo) so the app can dispatch .github/workflows/estimate-camera-pose.yml
# - GITHUB_REPO: "owner/repo" for this repository
# - CAMERA_POSE_SECRET: any random string, shared between this app and the
#   same-named repo secret, so the workflow's callback requests are
#   authenticated the same way /api/cron/process-jobs already is
GITHUB_DISPATCH_TOKEN=""
GITHUB_REPO=""
CAMERA_POSE_SECRET=""

# Real Gaussian Splat training (nerfstudio on a rented RunPod Serverless
# GPU — free-tier plan step B2, GPU path, triggered from a space's "Train
# real 3D splat" button). Costs real money per run (a rented GPU, not
# free like the COLMAP/GitHub Actions path above). Needs:
# - RUNPOD_API_KEY: from runpod.io/console/user/settings
# - RUNPOD_ENDPOINT_ID: the Serverless Endpoint id, created once in
#   RunPod's dashboard pointing at ghcr.io/yannyenks/spatial-splat-worker
#   (built by .github/workflows/build-splat-worker.yml)
# - SPLAT_TRAINING_SECRET: any random string, shared between this app and
#   the worker (passed per-job, not stored in the image), so the worker's
#   callback requests are authenticated the same way CAMERA_POSE_SECRET's
#   COLMAP callback already is
RUNPOD_API_KEY=""
RUNPOD_ENDPOINT_ID=""
SPLAT_TRAINING_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
